{
  "openapi": "3.0.3",
  "info": {
    "title": "Fastino-compatible GLiNER API",
    "version": "1.0.0",
    "description": "Local GLiNER2 inference through a Fastino-compatible chat-completions API. The assistant message content is itself a JSON-encoded extraction result."
  },
  "servers": [{"url": "/", "description": "Current server"}],
  "tags": [
    {"name": "Inference"},
    {"name": "Operations"}
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["Operations"],
        "summary": "Process liveness",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The server process is alive",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": ["Operations"],
        "summary": "Model readiness",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Model assets are loaded",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadyResponse"}}}
          },
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "tags": ["Inference"],
        "summary": "Extract structured information with GLiNER2",
        "description": "Analyzes the last non-empty string-valued user message. Streaming is not supported. If API_KEY is configured, use either Bearer authentication or X-API-Key.",
        "operationId": "createChatCompletion",
        "security": [{}, {"bearerAuth": []}, {"apiKeyAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ChatCompletionRequest"},
              "examples": {
                "entitiesAndRelations": {
                  "summary": "Combined entity and relation extraction",
                  "value": {
                    "model": "fastino/gliner2-base-v1",
                    "messages": [{"role": "user", "content": "Ada Lovelace worked with Charles Babbage."}],
                    "schema": {
                      "entities": [{"name": "person", "description": "a named individual"}],
                      "relations": ["worked_with"]
                    },
                    "threshold": 0.5,
                    "include_confidence": true,
                    "include_spans": true,
                    "store": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful non-streaming extraction",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChatCompletionResponse"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "413": {"$ref": "#/components/responses/PayloadTooLarge"},
          "422": {"$ref": "#/components/responses/UnprocessableEntity"},
          "429": {"$ref": "#/components/responses/TooManyRequests"},
          "500": {"$ref": "#/components/responses/InternalError"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"},
      "apiKeyAuth": {"type": "apiKey", "in": "header", "name": "X-API-Key"}
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {"status": {"type": "string", "example": "ok"}}
      },
      "ReadyResponse": {
        "type": "object",
        "required": ["status", "model"],
        "properties": {
          "status": {"type": "string", "example": "ready"},
          "model": {"type": "string", "example": "fastino/gliner2-base-v1"},
          "execution_provider": {"type": "string", "enum": ["cpu", "coreml"], "description": "Present when reported by the inference engine."}
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "example": "user"},
          "content": {"type": "string"}
        }
      },
      "NamedDescription": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      },
      "ClassificationTask": {
        "type": "object",
        "required": ["task", "labels"],
        "properties": {
          "task": {"type": "string"},
          "labels": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "multi_label": {"type": "boolean", "default": false},
          "top_k": {"type": "integer", "minimum": 1, "default": 1},
          "threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5}
        }
      },
      "StructureField": {
        "oneOf": [
          {"type": "string", "description": "field::type::description; type is str or list"},
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "dtype": {"type": "string", "enum": ["str", "list"], "default": "str"},
              "description": {"type": "string"},
              "choices": {"type": "array", "items": {"type": "string"}}
            }
          }
        ]
      },
      "RelationConfig": {
        "type": "object",
        "properties": {
          "description": {"type": "string"},
          "threshold": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "Schema": {
        "type": "object",
        "description": "At least one task family is required. A deprecated flat string array is also accepted as an entity schema.",
        "properties": {
          "entities": {
            "oneOf": [
              {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/components/schemas/NamedDescription"}]}},
              {"type": "object", "additionalProperties": {"type": "string"}}
            ]
          },
          "classifications": {
            "oneOf": [
              {"type": "array", "items": {"$ref": "#/components/schemas/ClassificationTask"}},
              {"type": "object", "description": "Task-to-label-array or task-to-configuration shorthand", "additionalProperties": true}
            ]
          },
          "structures": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {"type": "array", "items": {"$ref": "#/components/schemas/StructureField"}},
                {"type": "object", "required": ["fields"], "properties": {"fields": {"type": "array", "items": {"$ref": "#/components/schemas/StructureField"}}}}
              ]
            }
          },
          "relations": {
            "oneOf": [
              {"type": "array", "items": {"type": "string"}},
              {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/RelationConfig"}}
            ]
          }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": ["model", "messages", "schema"],
        "properties": {
          "model": {"type": "string", "default": "fastino/gliner2-base-v1"},
          "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/ChatMessage"}},
          "schema": {
            "oneOf": [
              {"$ref": "#/components/schemas/Schema"},
              {"type": "array", "deprecated": true, "items": {"type": "string"}}
            ]
          },
          "threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
          "include_confidence": {"type": "boolean", "default": true},
          "include_spans": {"type": "boolean", "default": true},
          "store": {"type": "boolean", "description": "Accepted for compatibility; data is not persisted."},
          "stream": {"type": "boolean", "default": false, "description": "Must be false."},
          "task": {"type": "string", "deprecated": true},
          "task_type": {"type": "string", "deprecated": true}
        }
      },
      "AssistantMessage": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["assistant"]},
          "content": {"type": "string", "description": "JSON-encoded object with entities, classifications, structures, and relations buckets."}
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "required": ["id", "object", "created", "model", "choices", "usage", "x_fastino"],
        "properties": {
          "id": {"type": "string"},
          "object": {"type": "string", "enum": ["chat.completion"]},
          "created": {"type": "integer", "format": "int64"},
          "model": {"type": "string"},
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "message", "finish_reason"],
              "properties": {
                "index": {"type": "integer"},
                "message": {"$ref": "#/components/schemas/AssistantMessage"},
                "finish_reason": {"type": "string", "enum": ["stop"]}
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {"type": "integer", "example": 0},
              "completion_tokens": {"type": "integer", "example": 0},
              "total_tokens": {"type": "integer", "example": 0}
            }
          },
          "x_fastino": {
            "type": "object",
            "properties": {"inference_id": {"type": "string", "nullable": true}}
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["message", "type", "code"],
            "properties": {
              "message": {"type": "string"},
              "type": {"type": "string"},
              "param": {"type": "string", "nullable": true},
              "code": {"type": "string"}
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {"description": "Malformed or unsupported request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Missing or invalid API key", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "Unknown model", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "PayloadTooLarge": {"description": "Request body is too large", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "UnprocessableEntity": {"description": "Required request data is missing or invalid", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "TooManyRequests": {"description": "Inference queue is full", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InternalError": {"description": "Inference or encoding failed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "ServiceUnavailable": {"description": "Model unavailable or inference timed out", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
